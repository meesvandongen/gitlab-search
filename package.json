{
	"name": "@mvd/gls",
	"version": "0.0.5",
	"description": "Interactive GitLab project search CLI (gls) with SWR caching",
	"type": "module",
	"private": false,
	"homepage": "https://github.com/meesvandongen/gitlab-search#readme",
	"author": "Mees van Dongen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/meesvandongen/gitlab-search.git"
	},
	"bugs": {
		"url": "https://github.com/meesvandongen/gitlab-search/issues"
	},
	"keywords": [
		"gitlab",
		"search",
		"cli",
		"swr",
		"gls",
		"gitlab-search"
	],
	"files": [
		"index.ts",
		"README.md"
	],
